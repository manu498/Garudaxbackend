# Copy this file to ".env" (same folder) and fill in your values. Never share the real .env file.

# ---- Email (needed for password reset codes and PDF complaint reports) ----
# Gmail example: turn on 2-Step Verification, then create an "App password" at
# https://myaccount.google.com/apppasswords and paste the 16-character password below.
GARUDAX_SMTP_HOST=smtp.gmail.com
GARUDAX_SMTP_PORT=587
GARUDAX_SMTP_USER=yourname@gmail.com
GARUDAX_SMTP_PASSWORD=your16charapppassword
GARUDAX_SMTP_FROM=yourname@gmail.com
# Optional extra address that receives 15-day escalation alerts
GARUDAX_AUTHORITY_EMAIL=

# ---- Optional tuning (defaults shown) ----
# GARUDAX_MIN_AI_CONFIDENCE=0.25        # trusted automatically at/above this
# GARUDAX_AI_REVIEW=1                    # 1 = AI-unsure photos go to the authority for review, 0 = reject them
# GARUDAX_AI_REVIEW_MIN_CONFIDENCE=0.03  # below this (nothing detected) is always rejected
# GARUDAX_DUPLICATE_RADIUS_M=30
# GARUDAX_ESCALATION_DAYS=15
# GARUDAX_ESCALATION_CHECK_MINUTES=30
# GARUDAX_SESSION_DAYS=7
